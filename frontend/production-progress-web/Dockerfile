# ============================================================
# 1. 依存関係インストール用ステージ
# ============================================================
# Node.js 22の軽量イメージを使用する。
#
# Next.jsのビルドと実行に必要なNode.js環境を用意する。
FROM node:22-alpine AS deps

# コンテナ内の作業フォルダ
WORKDIR /app


# ============================================================
# 2. package.json / package-lock.json をコピー
# ============================================================
#
# ソースコード全部を先にコピーせず、
# 依存関係の定義ファイルだけを先にコピーする。
#
# こうすることでpackage.jsonが変更されていない場合、
# npm ciのDockerキャッシュを再利用しやすくなる。
COPY package.json package-lock.json ./


# ============================================================
# 3. npmパッケージをインストール
# ============================================================
#
# npm installではなくnpm ciを使用する。
#
# package-lock.jsonに記録されているバージョンを
# そのまま使用するため、
# DockerやCI環境で同じ依存関係を再現しやすい。
RUN npm ci


# ============================================================
# 4. Next.jsビルド用ステージ
# ============================================================
FROM node:22-alpine AS builder

WORKDIR /app


# ============================================================
# 5. depsステージでインストールしたnode_modulesをコピー
# ============================================================
COPY --from=deps /app/node_modules ./node_modules


# ============================================================
# 6. Next.jsプロジェクト全体をコピー
# ============================================================
#
# .dockerignoreに記載された
# node_modulesや.nextなどはコピーされない。
COPY . .

# NEXT_PUBLIC_* はブラウザ側で使用されるため、
# Next.jsのビルド時に値を渡す必要がある。
ARG NEXT_PUBLIC_API_URL

# npm run build から参照できる環境変数にする。
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}


# ============================================================
# 7. Next.jsを本番用にビルド
# ============================================================
RUN npm run build


# ============================================================
# 8. 実行用ステージ
# ============================================================
FROM node:22-alpine AS runner

WORKDIR /app


# ============================================================
# 9. 本番環境として実行
# ============================================================
ENV NODE_ENV=production


# ============================================================
# 10. 実行に必要なファイルをコピー
# ============================================================
#
# package.json
# node_modules
# .next
# public
#
# を実行用コンテナへコピーする。
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/package-lock.json ./package-lock.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public


# ============================================================
# 11. Next.jsのポート
# ============================================================
EXPOSE 3000


# ============================================================
# 12. Next.jsを起動
# ============================================================
CMD ["npm", "start"]